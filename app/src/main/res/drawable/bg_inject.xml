<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#17FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF5E35B7"
                android:startColor="#FF0097A7" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/accent_deep"
                android:startColor="@color/accent" />
            <corners android:radius="28dp" />
        </shape>
    </item>

</selector>
