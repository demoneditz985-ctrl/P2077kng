<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/targetRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_target"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="13dp"
    android:paddingTop="14dp"
    android:paddingEnd="13dp"
    android:paddingBottom="14dp"
    tools:ignore="UnusedIds">

    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_flare"
        android:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.10"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="FREE FIRE" />

        <TextView
            android:id="@+id/txtPackage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            android:textColor="@color/text_dim"
            android:textSize="10.5sp"
            tools:text="com.dts.freefireth" />
    </LinearLayout>

    <TextView
        android:id="@+id/badgeInstalled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:text="@string/not_found"
        android:textColor="@color/text_dim"
        android:textSize="9.5sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:tint="@color/accent"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
